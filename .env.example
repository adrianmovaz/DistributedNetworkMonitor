# Configuración de la aplicación Python ejecutada en el equipo anfitrión.
# Prioridad: variables del proceso > este archivo > valores predeterminados.
# Usa --env-file RUTA para seleccionar el archivo desde cualquier directorio.
# Valores literales: no se expanden referencias como ${VARIABLE}.
DNM_HOST=127.0.0.1
DNM_PORT=8080
DNM_MODE=threaded
# Ruta relativa al directorio de este archivo; :memory: usa una base temporal.
DNM_DATABASE=data/monitor.db
DNM_MAX_CLIENTS=64
DNM_SOCKET_TIMEOUT=10
# Trabajadores y cupos pendientes de monitoreo. Las tareas persisten en SQLite.
# DNM_JOB_HISTORY limita la caché local de completadas y el historial DNS temporal.
DNM_MONITOR_WORKERS=4
DNM_MONITOR_QUEUE=32
DNM_JOB_HISTORY=128
# Reportes locales; ruta relativa al directorio de este archivo.
DNM_REPORT_DIRECTORY=data/reports
# Directorio FTP existente; vacío usa la raíz del usuario FTP.
DNM_REPORT_FTP_DIRECTORY=
DNM_REPORT_MAX_BYTES=4194304
DNM_REPORT_MAX_ATTEMPTS=3
DNM_REPORT_RETRY_DELAY=5

# Destinos de los clientes de protocolos implementados.
# Estos valores NO modifican Docker. El laboratorio se define en compose.yaml
# e infra/; si cambias un puerto publicado, ajusta aquí el destino correspondiente.
# Todos los tiempos de espera se expresan en segundos.
FTP_HOST=127.0.0.1
FTP_PORT=2121
FTP_USER=lab
FTP_PASSWORD=lab-only
FTP_TIMEOUT=10
# Tiempo total por operación y máximo de bytes por archivo o listado.
FTP_TRANSFER_TIMEOUT=60
FTP_MAX_BYTES=67108864

# Destino predeterminado de laboratorio; cada dispositivo conserva su host/puerto.
SNMP_HOST=127.0.0.1
SNMP_PORT=1161
SNMP_COMMUNITY=monitorlab
SNMP_TIMEOUT=3
SNMP_RETRIES=1
# Límite total por operación y máximo de variables (incluido el sistema).
SNMP_POLL_TIMEOUT=30
SNMP_MAX_VARIABLES=4096

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=monitor@monitor.test
SMTP_TO=admin@monitor.test
# Espera por socket; plazo total de conversación: SMTP_TIMEOUT multiplicado por 10.
SMTP_TIMEOUT=10
# Intentos máximos y espera inicial entre reintentos transitorios (segundos).
SMTP_MAX_ATTEMPTS=3
SMTP_RETRY_DELAY=5

# Dirección IP del servidor DNS; no usa el resolvedor del sistema como alternativa.
DNS_HOST=127.0.0.1
DNS_PORT=1053
DNS_TIMEOUT=3
