# The Python application runs on your host; Docker provides external lab services.
DNM_HOST=127.0.0.1
DNM_PORT=8080
DNM_MODE=threaded
DNM_DATABASE=data/monitor.db
DNM_MAX_CLIENTS=64
DNM_SOCKET_TIMEOUT=10

# Reserved for the protocol adapters to be implemented.
FTP_HOST=127.0.0.1
FTP_PORT=2121
FTP_USER=lab
FTP_PASSWORD=lab-only
SNMP_HOST=127.0.0.1
SNMP_PORT=1161
SNMP_COMMUNITY=monitorlab
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=monitor@monitor.test
SMTP_TO=admin@monitor.test
DNS_HOST=127.0.0.1
DNS_PORT=1053
