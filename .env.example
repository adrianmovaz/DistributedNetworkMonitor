# Configuración de la aplicación Python ejecutada en el equipo anfitrión.
# Prioridad: variables del proceso > este archivo > valores predeterminados.
# Usa --env-file RUTA para seleccionar el archivo desde cualquier directorio.
# Valores literales: no se expanden referencias como ${VARIABLE}.
DNM_HOST=127.0.0.1
DNM_PORT=8080
DNM_MODE=threaded
# Ruta relativa al directorio de este archivo; :memory: usa una base temporal.
DNM_DATABASE=data/monitor.db
DNM_MAX_CLIENTS=64
DNM_SOCKET_TIMEOUT=10

# Destinos de los futuros clientes: se cargan y validan, pero aún no se conectan.
# Estos valores NO modifican Docker. El laboratorio se define en compose.yaml
# e infra/; si cambias un puerto publicado, ajusta aquí el destino correspondiente.
# Todos los tiempos de espera se expresan en segundos.
FTP_HOST=127.0.0.1
FTP_PORT=2121
FTP_USER=lab
FTP_PASSWORD=lab-only
FTP_TIMEOUT=10

# Destino predeterminado de laboratorio; cada dispositivo conserva su host/puerto.
SNMP_HOST=127.0.0.1
SNMP_PORT=1161
SNMP_COMMUNITY=monitorlab
SNMP_TIMEOUT=3
SNMP_RETRIES=1

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=monitor@monitor.test
SMTP_TO=admin@monitor.test
SMTP_TIMEOUT=10

DNS_HOST=127.0.0.1
DNS_PORT=1053
DNS_TIMEOUT=3
